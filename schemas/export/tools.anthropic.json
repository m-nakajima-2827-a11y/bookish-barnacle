[
  {
    "name": "sync_lead_activity",
    "description": "Webサイト・LP・Instagram・メール・ウェビナー・広告・インサイドセールスの行動履歴と企業属性を、リードIDと企業（アカウント）IDに統合してリードプロファイルを更新する。資料DL、ウェビナー参加、問い合わせ、商談化・受注・失注の記録に使う",
    "input_schema": {
      "type": "object",
      "properties": {
        "lead_id": {
          "type": "string",
          "description": "MA/CRM上のリードID（メールアドレス等の個人情報ではなく、ハッシュ化または採番済みID）"
        },
        "account": {
          "type": "object",
          "description": "企業属性。初回登録時またはフォーム入力で更新があったときに指定",
          "properties": {
            "account_id": {
              "type": "string",
              "description": "企業ID（法人番号・CRM企業ID等）"
            },
            "industry": {
              "type": "string",
              "enum": [
                "it_saas",
                "manufacturing",
                "professional_services",
                "retail",
                "construction",
                "other"
              ]
            },
            "employee_band": {
              "type": "string",
              "enum": [
                "1-9",
                "10-49",
                "50-299",
                "300-999",
                "1000+"
              ]
            },
            "job_role": {
              "type": "string",
              "enum": [
                "executive",
                "sales_manager",
                "sales_rep",
                "marketing",
                "other",
                "student",
                "job_seeker"
              ]
            },
            "fiscal_year_end_month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "決算月（予算編成時期の推定に使用）"
            }
          }
        },
        "consent": {
          "type": "object",
          "description": "同意状態の取得・変更時のみ指定",
          "properties": {
            "email_opt_in": {
              "type": "boolean"
            },
            "unsubscribed": {
              "type": "boolean"
            }
          }
        },
        "touchpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "enum": [
                  "website",
                  "landing_page",
                  "instagram",
                  "email",
                  "webinar",
                  "search_ads",
                  "social_ads",
                  "inside_sales",
                  "offline_event"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "event_type": {
                "type": "string",
                "enum": [
                  "page_view",
                  "pricing_page_view",
                  "case_study_view",
                  "whitepaper_download",
                  "webinar_registration",
                  "webinar_attendance",
                  "email_open",
                  "email_click",
                  "social_engagement",
                  "ad_click",
                  "contact_request",
                  "sales_call",
                  "meeting_booked",
                  "deal_won",
                  "deal_lost"
                ]
              },
              "payload": {
                "type": "object",
                "description": "url、landing_page、utm（source/medium/campaign/content/term）、asset_id、webinar_id、amount（商談見込額・受注額）、lost_reason 等"
              }
            },
            "required": [
              "channel",
              "timestamp",
              "event_type"
            ]
          }
        }
      },
      "required": [
        "lead_id",
        "touchpoints"
      ]
    }
  },
  {
    "name": "score_and_qualify_leads",
    "description": "企業属性の適合度（フィット）と行動履歴（エンゲージメント）からリードスコアを算出し、MQL・ホットリード（営業引き渡し対象）・育成継続・対象外を判定する。同一企業の複数担当者の動き（購買関与者）も企業単位で評価する",
    "input_schema": {
      "type": "object",
      "properties": {
        "lead_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "判定対象のリードID。省略時は直近の行動があった全リード"
        },
        "analysis_window_days": {
          "type": "integer",
          "description": "行動履歴を評価する過去日数（例: 30, 90, 180）"
        },
        "include_account_view": {
          "type": "boolean",
          "description": "企業単位の集計（関与人数・企業スコア）を含めるか（既定: true）"
        }
      },
      "required": []
    }
  },
  {
    "name": "trigger_nurture_action",
    "description": "リードの業界・検討段階に応じて、育成シナリオ登録、メール配信、ウェビナー招待、次に読むべき資料の案内、インサイドセールスへの引き渡し（初回接触期限つきタスク）、予算編成時期に合わせた再アプローチ予約を実行する",
    "input_schema": {
      "type": "object",
      "properties": {
        "lead_id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "enroll_nurture_track",
            "send_email",
            "invite_webinar",
            "recommend_content",
            "sales_handoff",
            "schedule_recontact"
          ]
        },
        "nurture_track": {
          "type": "string",
          "enum": [
            "it_saas",
            "manufacturing",
            "general"
          ],
          "description": "育成シナリオ。省略時はリードの業界から自動選択"
        },
        "content_asset_id": {
          "type": "string",
          "description": "案内する資料・ウェビナーのID（config のコンテンツ一覧）"
        },
        "payload_details": {
          "type": "object",
          "description": "件名、本文差し込み、recontact_date（YYYY-MM-DD）、handoff_note 等"
        }
      },
      "required": [
        "lead_id",
        "action"
      ]
    }
  },
  {
    "name": "optimize_lead_gen_campaigns",
    "description": "リード獲得広告（Google/Yahoo!検索、Meta・Instagram、LinkedIn）について、既存顧客・商談中企業・対象外リードの除外同期、商談化単価（Cost per SQL）を重視した予算再配分、入札戦略の変更、低成果クリエイティブの停止を行う",
    "input_schema": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "google_ads",
            "yahoo_ads",
            "meta_ads",
            "linkedin_ads"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "sync_audience_exclusion",
            "update_budget",
            "adjust_bidding_strategy",
            "pause_underperforming_creative"
          ]
        },
        "target_segment_id": {
          "type": "string",
          "description": "除外同期では customers / open_opportunities / disqualified など。その他の操作では対象キャンペーンの絞り込み"
        },
        "optimization_metrics": {
          "type": "object",
          "properties": {
            "target_cpl": {
              "type": "number",
              "description": "目標リード獲得単価（円）"
            },
            "target_cost_per_sql": {
              "type": "number",
              "description": "目標商談化単価（円）"
            }
          }
        }
      },
      "required": [
        "platform",
        "action"
      ]
    }
  },
  {
    "name": "build_utm_tracking_url",
    "description": "GA4で流入元を正しく計測するためのUTMパラメータ付きURLを作成する。小文字統一・全角文字禁止などの命名ルールを検証し、GA4での想定チャネル分類を返し、キャンペーン台帳に登録する",
    "input_schema": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "リンク先のページURL（LP・資料DLページ等）"
        },
        "utm_source": {
          "type": "string",
          "description": "流入元の媒体名（例: instagram, google, newsletter）"
        },
        "utm_medium": {
          "type": "string",
          "description": "流入の種類（例: social, paid_social, cpc, email）"
        },
        "utm_campaign": {
          "type": "string",
          "description": "企画名（例: mfg_paper, it_seminar）。半角英数字・_・- のみ"
        },
        "utm_content": {
          "type": "string",
          "description": "リンクの設置場所やクリエイティブの区別（例: profile_link, story_it）"
        },
        "utm_term": {
          "type": "string",
          "description": "検索広告のキーワード等（任意）"
        },
        "placement": {
          "type": "string",
          "enum": [
            "instagram_profile",
            "instagram_story",
            "instagram_post",
            "instagram_ad",
            "email_newsletter",
            "webinar_invite",
            "search_ad",
            "other"
          ],
          "description": "リンクの設置場所。utm_content 省略時の既定値と命名チェックに使用"
        },
        "target_industry": {
          "type": "string",
          "enum": [
            "it_saas",
            "manufacturing",
            "general"
          ]
        }
      },
      "required": [
        "base_url",
        "utm_source",
        "utm_medium",
        "utm_campaign"
      ]
    }
  },
  {
    "name": "plan_social_content_calendar",
    "description": "BtoB向けInstagram運用の投稿カレンダーを作成する。業界別（IT・製造業）のテーマ、投稿形式（保存狙いの図解カルーセル、導入事例、中の人リール、ウェビナー告知ストーリーズ）、資料DLへのUTM付き導線、投稿ごとのKPIを割り当てる。新規アカウントの場合はプロフィール設計のチェックリストも出力する",
    "input_schema": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "posting_days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "description": "投稿曜日（既定: mon, fri）"
        },
        "target_industries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "it_saas",
              "manufacturing"
            ]
          }
        },
        "account_status": {
          "type": "string",
          "enum": [
            "new",
            "active"
          ],
          "description": "new の場合、プロフィール設計チェックリストを含める"
        },
        "include_webinar_stories": {
          "type": "boolean",
          "description": "ウェビナー告知ストーリーズを含めるか（既定: true）"
        }
      },
      "required": [
        "start_date",
        "weeks",
        "target_industries"
      ]
    }
  },
  {
    "name": "analyze_marketing_funnel",
    "description": "GA4の流入データ、サーチコンソールの検索クエリ、MA/CRMのリード・商談データを統合し、流入元・キャンペーン・LP・業界別に、セッション→資料DL→MQL→ホットリード→商談→受注のファネルと商談金額の貢献を分析する。UTMの表記ゆれ、指名検索の推移、初回接触までの時間も点検し、改善提案を出力する",
    "input_schema": {
      "type": "object",
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "group_by": {
          "type": "string",
          "enum": [
            "channel_group",
            "source_medium",
            "campaign",
            "landing_page",
            "industry"
          ]
        },
        "attribution_model": {
          "type": "string",
          "enum": [
            "first_touch",
            "last_touch",
            "linear",
            "position_based"
          ],
          "description": "商談金額をどの接点に配分するか（既定: first_touch = リード創出元）"
        },
        "include_search_console": {
          "type": "boolean",
          "description": "検索クエリ分析を含めるか（既定: true）"
        },
        "output_format": {
          "type": "string",
          "enum": [
            "json",
            "markdown"
          ]
        }
      },
      "required": [
        "period_start",
        "period_end",
        "group_by"
      ]
    }
  },
  {
    "name": "ma_track_activity",
    "description": "Webサイトに設置した計測タグ相当の機能。匿名客（Cookie）・実名客のWebアクセス、メール開封・クリック、配信停止、ポップアップ表示・クリック、Webプッシュ許諾・クリックを記録し、スコア加算・セグメント判定・シナリオ起動を行う。ページ表示時に出すべきポップアップも返す",
    "input_schema": {
      "type": "object",
      "properties": {
        "visitor_id": {
          "type": "string",
          "description": "計測CookieのID（匿名客の識別子）。メール起点のイベントでは省略可"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "web_access",
                  "email_open",
                  "email_click",
                  "unsubscribe",
                  "popup_view",
                  "popup_click",
                  "push_permission",
                  "push_click"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "url": {
                "type": "string",
                "description": "アクセスしたページURL（クエリにUTMがあれば自動抽出）"
              },
              "referrer": {
                "type": "string"
              },
              "email_token": {
                "type": "string",
                "description": "メール内リンク・開封画像・配信停止リンクのトークン"
              },
              "popup_id": {
                "type": "string"
              },
              "push_id": {
                "type": "string"
              },
              "granted": {
                "type": "boolean",
                "description": "push_permission の許諾結果"
              }
            },
            "required": [
              "type",
              "timestamp"
            ]
          }
        },
        "return_popup": {
          "type": "boolean",
          "description": "最後の web_access の URL に対して表示すべきポップアップを返すか（既定: true）"
        }
      },
      "required": [
        "events"
      ]
    }
  },
  {
    "name": "ma_manage_customer",
    "description": "カスタマー（匿名客・実名客）の参照・検索・属性更新・タグ付与/削除・配信停止・同意記録を行う。連絡先（メールアドレス等）は出力時に常にマスクされる",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "get",
            "search",
            "update_attributes",
            "add_tag",
            "remove_tag",
            "unsubscribe",
            "record_opt_in"
          ]
        },
        "customer_id": {
          "type": "string",
          "description": "実名客のID（匿名客は visitor_id で指定）"
        },
        "visitor_id": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "description": "company_name, industry, employee_band, job_role, department, fiscal_year_end_month 等"
        },
        "tag": {
          "type": "string"
        },
        "opt_in_evidence": {
          "type": "string",
          "description": "record_opt_in 時の同意取得の根拠（例: 名刺交換時の書面同意、展示会フォーム）"
        },
        "query": {
          "type": "object",
          "description": "search 用。tag / segment_id / min_score / identified / limit"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "ma_manage_form",
    "description": "フォームの作成・取得・送信処理を行う。送信時はメールアドレスで名寄せして実名化し、匿名時代の行動履歴を引き継ぎ、同意・属性・タグ・スコアを反映、自動返信メールと社内通知を送り、リード（資料DL・セミナー申込・問い合わせ）として登録する",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "get",
            "list",
            "submit"
          ]
        },
        "form_id": {
          "type": "string"
        },
        "definition": {
          "type": "object",
          "description": "create 用。name, fields[{key,label,type(text|email|tel|select|checkbox),required,options,maps_to}], lead_event(whitepaper_download|webinar_registration|contact_request), asset_id, tags_on_submit[], auto_reply{subject,body,asset_id}, notify[{channel(webhook|crm_task),to,message}], consent_field, thanks_url"
        },
        "submission": {
          "type": "object",
          "description": "submit 用。visitor_id, values{項目キー: 値}, page_url, timestamp"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "ma_create_landing_page",
    "description": "キャンペーン用の簡易ランディングページ（LP）を作成する。見出し・訴求ポイント・フォームを組み込んだHTMLを生成し、計測タグとフォームを設定済みの公開用ファイルとURLを返す",
    "input_schema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "URLパス（/lp/<slug>）。半角英小文字・数字・ハイフン"
        },
        "title": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "subheadline": {
          "type": "string"
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "訴求ポイント（3つ程度）"
        },
        "form_id": {
          "type": "string"
        },
        "target_industry": {
          "type": "string",
          "enum": [
            "it_saas",
            "manufacturing",
            "general"
          ]
        },
        "theme_color": {
          "type": "string",
          "description": "Instagram投稿のトーンに合わせたメインカラー（例: #1F3A5F）"
        }
      },
      "required": [
        "slug",
        "title",
        "headline",
        "form_id"
      ]
    }
  },
  {
    "name": "ma_manage_segment",
    "description": "条件に合うカスタマー（匿名客を含む）を自動で抽出するセグメントを作成・更新・試算・一覧・メンバー取得する。条件はページ閲覧（URL・回数・期間）、UTM、メール開封・クリック、フォーム送信、タグ、スコア、属性、実名/匿名、プッシュ許諾、配信同意、リードステージを all/any/not で組み合わせる",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "preview",
            "list",
            "members",
            "pause"
          ]
        },
        "segment_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "conditions": {
          "type": "object",
          "description": "例: {\"all\":[{\"type\":\"page_view\",\"url_contains\":\"/price\",\"within_days\":30},{\"type\":\"identified\",\"value\":true}]}"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "ma_configure_scoring",
    "description": "スコア定義を設定する。共通設定（アクション種別ごとの加減点: Webアクセス、メール開封、メール内リンククリック、配信停止、フォーム送信等）と、個別設定（特定URL・パラメータのアクセス、特定フォーム送信、タグ付与時、セグメント該当時）を管理する。点数は±100,000以内の整数",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "get",
            "set_common",
            "add_rule",
            "remove_rule",
            "distribution"
          ]
        },
        "action_type": {
          "type": "string",
          "enum": [
            "web_access",
            "email_open",
            "email_click",
            "unsubscribe",
            "form_submit",
            "popup_click",
            "push_click"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "rule": {
          "type": "object",
          "description": "add_rule 用。target(web_access|form_submit|tag_added|segment_entered), url_filter, param_filter(例 utm_campaign=mfg_paper), form_id, key(タグ名/セグメントID), points, name"
        },
        "rule_id": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "ma_manage_scenario",
    "description": "トリガー（セグメント該当・フォーム送信・タグ付与）を起点に、ステップメール、タグ付与・削除、社内通知（Webhook・CRMタスク）を日数指定で自動実行するシナリオを作成・開始・停止・一覧・手動登録する。リードのステージやタグによる途中離脱条件も設定できる",
    "input_schema": {
      "type": "object",
      "properties": {
