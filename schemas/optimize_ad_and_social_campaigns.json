{
  "name": "optimize_ad_and_social_campaigns",
  "description": "購買済みユーザーの除外設定、類似セグメントの広告媒体への同期、および自動入札・予算配分の調整を実行する",
  "parameters": {
    "type": "object",
    "properties": {
      "platform": {
        "type": "string",
        "enum": ["google_ads", "meta_ads", "line_ads", "x_ads"]
      },
      "action": {
        "type": "string",
        "enum": ["sync_audience_exclusion", "update_budget", "adjust_bidding_strategy", "pause_underperforming_creative"]
      },
      "target_segment_id": { "type": "string" },
      "optimization_metrics": {
        "type": "object",
        "properties": {
          "target_roas": { "type": "number" },
          "max_cpa": { "type": "number" }
        }
      }
    },
    "required": ["platform", "action"]
  }
}
